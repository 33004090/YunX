<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- APK 安装：Android 8+ 检查「安装未知来源应用」权限需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 9- 写公共 Download 目录需要（10 走 MediaStore，legacy 模式回退也需要） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".YunXApp"
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.ComposeEmptyActivity">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ComposeEmptyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃界面：独立进程运行，避免主线程崩溃后无法展示 UI -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- 下载前台服务：下载中保持前台，避免后台限速/进程被杀 -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 文件共享：导出日志等场景（ACTION_SEND 分享） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>